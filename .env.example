APP_NAME="BOA TTS Service"

HF_HOME=/models/hf_cache
MODEL_CACHE_DIR=/models/cache

TTS_DEVICE=cuda

AMHARIC_TTS_MODEL=african-low-resource/omnivoice-amharic
AMHARIC_VOICE_REFERENCE_PATH=/app/assets/voices/amharic_reference_voice.mp3
AMHARIC_VOICE_REFERENCE_TEXT_PATH=/app/assets/voices/amharic_reference_voice.txt
AMHARIC_TTS_CHUNK_CHARS=140
AMHARIC_TTS_CHUNK_PAUSE_MS=120

REQUEST_TIMEOUT_SECONDS=300

# Default delivery directions for the gemini and openrouter providers, e.g.
# "calm and clear". Each request can override it with "instructions".
TTS_INSTRUCTIONS=

# local: OmniVoice model on the GPU (default). gemini: Gemini API.
# openrouter: Gemini TTS through OpenRouter (prebuilt voices only).
TTS_PROVIDER=local

# Used when TTS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Prebuilt voice name (e.g. Kore), or a cloned voice ID from
# `uv run python -m scripts.create_gemini_voice --consent consent.wav`
GEMINI_TTS_VOICE=Kore
# Optional ISO 639-1 code (e.g. am); empty lets Gemini detect the language
GEMINI_TTS_LANGUAGE_CODE=

# Used when TTS_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
# Prebuilt voice name (e.g. Kore); cloned voice IDs don't work here
OPENROUTER_TTS_VOICE=Kore
# Upstream calls in flight at once; extra requests wait for a free slot
OPENROUTER_MAX_CONCURRENCY=4
# Each attempt is cut off after this long, then retried with backoff
OPENROUTER_ATTEMPT_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
